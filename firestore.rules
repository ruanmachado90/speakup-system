rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para a coleção de payments
    match /payments/{paymentId} {
      // Permitir leitura pública de um pagamento específico (para links de pagamento)
      allow read: if true;
      // Permitir escrita apenas para usuários autenticados
      allow write: if request.auth != null;
    }
    
    // Todas as outras coleções: apenas usuários autenticados
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
