rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Links de pagamento: leitura pública (professores e alunos acessam sem login)
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Turmas: leitura para qualquer auth (inclui anônimo usado pelo painel do professor)
    match /turmas/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Aulas: leitura e escrita para qualquer auth (professores anônimos registram aulas)
    match /aulas/{docId} {
      allow read, write: if request.auth != null;
    }

    // Agenda de professores
    match /agendaEventos/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Dados principais do sistema (path artifacts): qualquer auth autenticada pode ler e escrever
    // (admin usa signInAnonymously; professores só acessam coleções raiz como aulas/turmas)
    match /artifacts/{appId}/public/data/{collection}/{docId} {
      allow read, write: if request.auth != null;
    }

    // Demais coleções raiz (vendas, estoque, etc.): apenas autenticados não-anônimos
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
